# Copy to .env and fill in. .env is gitignored.

# Required for match generation (phase 2).
ANTHROPIC_API_KEY=sk-ant-...

# Optional — only needed to re-mine ground truth (phase 4).
# The cleaned output is committed, so most work doesn't need these.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=elsewhere-eval/0.1
